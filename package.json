{
  "name": "billing_software",
  "private": true,
  "version": "0.0.1",
  "main": "electron/main.js",
  "author": "Thomas LETERME",
  "license": "ISC",
  "description": "Billing Software",
  "module": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",

    "electron:start": "cross-env NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron-forge start\"",
    "electron:build": "electron-builder",
    
    "xcode": "npx cap open ios",
    "android": ""
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/electron": "^2.5.0",
    "@capacitor/ios": "^6.1.2",
    "axios": "^1.7.7",
    "bootstrap": "^5.3.3",
    "electron-squirrel-startup": "^1.0.1",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-deb": "^7.5.0",
    "@electron-forge/maker-rpm": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.5.0",
    "@electron-forge/plugin-fuses": "^7.5.0",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.6.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vue-loader": "^17.3.1",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "^2.1.8",
    "wait-on": "^8.0.1",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "build": {
    "appId": "com.facturation.app",
    "productName": "Billing Software",
    "directories": {
      "output": "dist/electron"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
